[Unit]
Description=Enable hw_server
Wants=jtag-mode.service
After=jtag-mode.service xvc.service jtag-controller-config.service
PartOf=xvc.service jtag-controller-config.service
ConditionPathExists=/run/labtool/hws.txt

[Service]
Type=simple
Restart=always
NotifyAccess=all
ExecStart=/opt/labtools/bin/hw_server --init=/run/labtool/hws.txt
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
